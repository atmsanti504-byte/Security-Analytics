def assign_severity(row):
    text = (
        str(row["observed_action"]) + " " +
        str(row["analytical_interpretation"])
    ).lower()

    if "critical" in text:
        return 4, "Critical Risk"

    if "high" in text:
        return 3, "High Risk"

    if (
        "mfa" in text and
        ("deny" in text or "denial" in text)
    ):
        return 4, "Critical Risk"

    if any(keyword in text for keyword in [
        "mshta",
        "powershell",
        "rundll32",
        "update.hta"
    ]):
        return 3, "High Risk"

    if any(keyword in text for keyword in [
        "restricted",
        "confidential",
        "sensitive",
        "download",
        "upload"
    ]):
        return 2, "Medium Risk"

    return 0, "Baseline"


