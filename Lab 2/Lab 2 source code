def create_label(row):
    text = str(row["observed_action"]).lower()

    if row["severity"] == 0:
        return ""

    if "mshta" in text:
        return "Suspicious Payload (mshta)"
    elif "powershell" in text:
        return "PowerShell Activity"
    elif "rundll32" in text:
        return "PowerShell/rundll32"
    elif "mfa" in text:
        return "Suspicious MFA Activity"
    elif "upload" in text:
        return "External Data Transfer"
    elif "restricted" in text or "confidential" in text:
        return "Sensitive Resource Access"

    return row["evidence_source"]


